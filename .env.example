# Porta do servidor HTTP (API principal + API falsa do WhatsApp no mesmo processo)
PORT=3000

# Caminho do arquivo SQLite (criado automaticamente se não existir)
DB_PATH=./data/leads.db

# Caminho do arquivo de log estruturado
LOG_PATH=./logs/application.log

# Intervalo do worker de polling (ms) que detecta leads novos/qualificados e pendências de envio
POLL_INTERVAL_MS=5000

# SLA máximo entre "lead qualificado" e "mensagem enviada", em segundos
SLA_SECONDS=120

# Probabilidade de falha simulada da API falsa do WhatsApp (0 a 1)
WHATSAPP_FAILURE_RATE=0.2

# Nº de tentativas locais de envio (com backoff) antes de marcar o lead como "retrying"
# e devolvê-lo para o próximo ciclo de polling
MAX_RETRIES=4

# Nº total de tentativas acumuladas (entre ciclos de polling) antes de mover o lead
# para dead-letter (status=erro) definitivamente
MAX_TOTAL_ATTEMPTS=8

# Atrasos (ms) entre as tentativas locais de backoff, alinhados a MAX_RETRIES
RETRY_DELAYS_MS=0,2000,5000,10000

# Score mínimo para um lead ser elegível à qualificação
QUALIFICATION_MIN_SCORE=70

# URL base usada pelo whatsapp.service para chamar a API falsa (mesmo processo)
WHATSAPP_API_BASE_URL=http://localhost:3000

# Timeout (ms) para cada chamada HTTP à API falsa do WhatsApp
WHATSAPP_HTTP_TIMEOUT_MS=5000
